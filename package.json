{
  "name": "nextly-workspace",
  "private": true,
  "scripts": {
    "install:frontend": "npm --prefix webapp/frontend install",
    "install:backend": "python -m pip install -e ./backend",
    "install:backend:dev": "python -m pip install -e \"./backend[dev]\"",
    "build": "npm --prefix webapp/frontend run build",
    "dev": "npm --prefix webapp/frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "db:upgrade": "python -m alembic -c backend/alembic.ini upgrade head",
    "db:current": "python -m alembic -c backend/alembic.ini current",
    "db:restore": "python -m app.cli restore",
    "test:backend": "python -m pytest backend/tests",
    "preview": "npm --prefix webapp/frontend run preview"
  }
}